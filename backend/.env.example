# Copy this file to .env and fill in real values. Never commit .env.

# EVE SSO application (developers.eveonline.com) - needs the
# esi-markets.structure_markets.v1 scope enabled.
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
ESI_CALLBACK_URL=https://keepstar.1337servers.com/api/auth/callback

# Port the Express server listens on
PORT=3002

NODE_ENV=development
