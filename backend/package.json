{
  "name": "keepstar-inventory-backend",
  "version": "1.0.0",
  "description": "Backend poller and REST API for the Keepstar market inventory tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "test": "cross-env ESI_CLIENT_ID=smoke-test-client ESI_CLIENT_SECRET=smoke-test-secret ESI_CALLBACK_URL=http://localhost:3002/api/auth/callback tsx --test src/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "cross-env": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
